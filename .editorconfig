# EditorConfig — https://editorconfig.org
# Formatting baseline for this repository. The Python indent below matches what
# `ruff format` produces, so the editor and the formatter cannot disagree.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.toml]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; keep them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
