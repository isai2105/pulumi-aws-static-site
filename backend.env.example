# backend.env — where the environment stacks' state lives. Local use only.
#
# Copy this file to backend.env (gitignored) and fill both values from the
# bootstrap stack's outputs:
#
#     cp backend.env.example backend.env
#     PULUMI_BACKEND_URL=file://$PWD/bootstrap/.pulumi-state pulumi -C bootstrap stack output --stack bootstrap
#
# The Makefile's preview-/up-/destroy-/cancel-<env> targets source this file
# and compose the backend URL on each command line — never exported, never
# `pulumi login` — as `s3://$PULUMI_STATE_BUCKET?region=$AWS_REGION&awssdk=v2`;
# `verify-teardown` and `print-state-bucket` read PULUMI_STATE_BUCKET from it
# when the variable is not already exported. In CI the same two values are the
# repository variables of the same names (docs/BOOTSTRAP.md §6), so this file
# is never needed on a runner.
#
# Neither value is a secret. The bucket name carries a per-account random
# suffix, which is the only reason it is not committed; the region is the one
# the bootstrap was applied with (static-site-bootstrap:awsRegion). The
# passphrase does NOT go here: export PULUMI_CONFIG_PASSPHRASE in the shell.

# The state bucket the bootstrap created, e.g. isai2105-pulumi-pulumistate-abcd1234
PULUMI_STATE_BUCKET=

# The bucket's region, e.g. us-east-2
AWS_REGION=
